<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- ========================================
         实验2：Setter注入（设置注入）
         演示：通过<property>标签注入各种类型的属性
         ======================================== -->
    
    <!-- 配置数据访问层Bean，注入基本类型属性 -->
    <bean id="labProductDao" class="com.study.ssm.lab.experiment2.dao.impl.ProductDaoImpl">
        <!-- 注入String类型属性 -->
        <property name="databaseUrl" value="jdbc:mysql://localhost:3306/shop_db"/>
        <property name="databaseUser" value="root"/>
    </bean>
    
    <!-- 配置业务层Bean，注入对象和多种基本类型属性 -->
    <bean id="labProductService" class="com.study.ssm.lab.experiment2.service.impl.ProductServiceImpl">
        <!-- 注入对象引用 - 使用ref属性 -->
        <property name="productDao" ref="labProductDao"/>
        
        <!-- 注入String类型 -->
        <property name="serviceName" value="商品管理服务"/>
        
        <!-- 注入int类型 -->
        <property name="maxRetryTimes" value="3"/>
        
        <!-- 注入double类型 -->
        <property name="discountRate" value="0.15"/>
    </bean>

</beans>
