<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
    
<mapper namespace="com.study.ssm.mapper.ItemMapper">
    
    <!-- 公共列片段：Item表基础列 -->
    <sql id="Item_Columns">
        order_id, article_id, amount
    </sql>
    <!-- 公共列片段（带表别名前缀i.） -->
    <sql id="Item_Columns_Prefixed">
        i.order_id,
        i.article_id,
        i.amount
    </sql>
    
    <!-- 订单明细结果映射（基础） -->
    <resultMap id="BaseItemMap" type="Item">
        <result column="order_id" property="orderId"/>
        <result column="article_id" property="articleId"/>
        <result column="amount" property="amount"/>
    </resultMap>
    
    <!-- 订单明细结果映射（包含商品信息） -->
    <resultMap id="ItemWithArticleMap" type="Item" extends="BaseItemMap">
        <association property="article" javaType="Article">
            <id column="article_id" property="id"/>
            <result column="article_name" property="name"/>
            <result column="article_price" property="price"/>
            <result column="article_remark" property="remark"/>
        </association>
    </resultMap>
    
    <!-- 根据订单ID查询订单明细 -->
    <select id="selectItemsByOrderId" parameterType="Integer" resultMap="BaseItemMap">
        SELECT <include refid="Item_Columns"/>
        FROM tb_item
        WHERE order_id = #{orderId}
    </select>
    
    <!-- 根据订单ID查询订单明细（包含商品信息） -->
    <select id="selectItemsWithArticleByOrderId" parameterType="Integer" resultMap="ItemWithArticleMap">
        SELECT 
            <include refid="Item_Columns_Prefixed"/>,
            a.id as article_id,
            a.name as article_name,
            a.price as article_price,
            a.remark as article_remark
        FROM tb_item i
        INNER JOIN tb_article a ON i.article_id = a.id
        WHERE i.order_id = #{orderId}
    </select>
    
    <!-- 插入订单明细 -->
    <insert id="insertItem" parameterType="Item">
        INSERT INTO tb_item (order_id, article_id, amount)
        VALUES (#{orderId}, #{articleId}, #{amount})
    </insert>
    
    <!-- 更新订单明细 -->
    <update id="updateItem" parameterType="Item">
        UPDATE tb_item
        SET amount = #{amount}
        WHERE order_id = #{orderId} AND article_id = #{articleId}
    </update>
    
    <!-- 删除订单明细 -->
    <delete id="deleteItem">
        DELETE FROM tb_item
        WHERE order_id = #{orderId} AND article_id = #{articleId}
    </delete>
    
    <!-- 根据订单ID删除所有订单明细 -->
    <delete id="deleteItemsByOrderId" parameterType="Integer">
        DELETE FROM tb_item
        WHERE order_id = #{orderId}
    </delete>
    
</mapper>
