<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.study.ssm.mapper.StudentMapper">

    <!-- 公共列片段：学生及其班级关联查询的列清单 -->
    <sql id="Student_With_Clazz_Columns">
        s.id AS s_id,
        s.name AS s_name,
        s.sex AS s_sex,
        s.age AS s_age,
        s.clazz_id AS s_clazz_id,
        c.id AS c_id,
        c.code AS c_code,
        c.name AS c_name
    </sql>

    <!-- 学生结果映射（包含班级信息） -->
    <resultMap id="StudentWithClazzResultMap" type="Student">
        <id property="id" column="s_id"/>
        <result property="name" column="s_name"/>
        <result property="sex" column="s_sex"/>
        <result property="age" column="s_age"/>
        <result property="clazzId" column="s_clazz_id"/>
        
        <!-- 关联班级信息 -->
        <association property="clazz" javaType="Clazz">
            <id property="id" column="c_id"/>
            <result property="code" column="c_code"/>
            <result property="name" column="c_name"/>
        </association>
    </resultMap>

    <!-- 根据ID查询学生信息（包含班级信息） -->
    <select id="selectStudentWithClazzById" resultMap="StudentWithClazzResultMap">
        SELECT 
            <include refid="Student_With_Clazz_Columns"/>
        FROM tb_student s
        LEFT JOIN tb_clazz c ON s.clazz_id = c.id
        WHERE s.id = #{id}
    </select>

    <!-- 查询所有学生信息（包含班级信息） -->
    <select id="selectAllStudentsWithClazz" resultMap="StudentWithClazzResultMap">
        SELECT 
            <include refid="Student_With_Clazz_Columns"/>
        FROM tb_student s
        LEFT JOIN tb_clazz c ON s.clazz_id = c.id
        ORDER BY s.id
    </select>

    <!-- 根据班级ID查询学生列表（包含班级信息） -->
    <select id="selectStudentsByClazzId" resultMap="StudentWithClazzResultMap">
        SELECT 
            <include refid="Student_With_Clazz_Columns"/>
        FROM tb_student s
        LEFT JOIN tb_clazz c ON s.clazz_id = c.id
        WHERE s.clazz_id = #{clazzId}
        ORDER BY s.id
    </select>

    <!-- 根据学生姓名查询学生信息（包含班级信息） -->
    <select id="selectStudentWithClazzByName" resultMap="StudentWithClazzResultMap">
        SELECT 
            <include refid="Student_With_Clazz_Columns"/>
        FROM tb_student s
        LEFT JOIN tb_clazz c ON s.clazz_id = c.id
        WHERE s.name = #{name}
    </select>

    <!-- 插入学生信息 -->
    <insert id="insertStudent" parameterType="Student" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tb_student (name, sex, age, clazz_id) 
        VALUES (#{name}, #{sex}, #{age}, #{clazzId})
    </insert>

    <!-- 更新学生信息 -->
    <update id="updateStudent" parameterType="Student">
        UPDATE tb_student 
        SET name = #{name}, sex = #{sex}, age = #{age}, clazz_id = #{clazzId}
        WHERE id = #{id}
    </update>

    <!-- 删除学生信息 -->
    <delete id="deleteStudent" parameterType="int">
        DELETE FROM tb_student WHERE id = #{id}
    </delete>

</mapper>
